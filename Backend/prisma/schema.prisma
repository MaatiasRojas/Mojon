datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Reserva {
  id       Int      @id @default(autoincrement())
  fechaInicio    String // "YYYY-MM-DD"
  fechaFin       String // "YYYY-MM-DD"
  motivo   String? // opcional: "reserva", "mantenimiento", etc.
  cliente  String?
  sena     Boolean  @default(false)
  montoSena Float?
  pago     Boolean  @default(false)
  montoPago Float?
  //Id del evento en Google Calendar asi se puede editar/borrar
  googleEventId String?
  creadoEn DateTime @default(now())
}

// Solo va a existir UN registro acá — es intencional, es un único admin.
model Admin {
  id           Int      @id @default(autoincrement())
  passwordHash String
  //Refresh token de Google OAuth, se completa cuando el cliente conecta su google calendar
  googleRefreshToken String?
  creadoEn     DateTime @default(now())
}
